# Copy to .env and fill in real values. Never commit .env.

# MongoDB connection string
MONGO_URI=mongodb://localhost:27017/elogbook

# Secret used to sign JWTs (use a long random value in production)
JWT_SECRET=change-me

# Port the API listens on
PORT=5000

# Frontend origin allowed by CORS (no trailing slash)
# Local Vite dev server:
CLIENT_URL=http://localhost:5173

# --- ML anomaly detection (optional; defaults shown) ---
# Python interpreter used to run elogbook-ml/anomaly.py. That
# interpreter needs the packages in elogbook-ml/requirements.txt.
# On Windows dev machines this is usually "python".
# PYTHON_BIN=python3
# Max time (ms) an anomaly request may take before it is aborted.
# ML_TIMEOUT_MS=15000
# Expected share of anomalies in parameter data, in (0, 0.5].
# Read by anomaly.py itself.
# ML_CONTAMINATION=0.05
