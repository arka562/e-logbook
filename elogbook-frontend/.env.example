# Copy to .env and adjust. Never commit .env.
#
# Base URL of the backend API, called by the browser app.
# Vite bakes this into the bundle at build time — after changing
# it you must rebuild (npm run build) or restart the dev server.
# Leave unset to use the local default http://localhost:5000/api.
VITE_API_BASE_URL=http://localhost:5000/api
